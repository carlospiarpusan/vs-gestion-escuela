{
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/facturas-correo",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/suscripciones",
      "schedule": "30 11 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept-Encoding"
        }
      ]
    }
  ]
}
